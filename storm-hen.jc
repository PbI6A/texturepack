inline var henName = "Грозовая Курица";
inline var henBodyName = "storm_hen_body";
inline var henFeatherName = "storm_hen_feather";
inline var henMarkName = "storm_hen_mark";
game var shRunning = 0;
game var shStop = 0;
game var shDefeated = 0;
game var shOwner = "";
game var shBoss = "";
game var shBody = "";
game var shFeather = "";
game var shMark = "";
game var shRage = 0;
game var shFrame = -1;
game var shNewVisual = "";

function shSpawnVisual(position, displayName, frameItem, scale, role) {
    shNewVisual = "";
    var previousId = value::uuid<last_entity>;
    world::spawn_item_display(position, displayName, item("paper"));

    select::last_entity();
    var candidate = value::uuid<current>;
    var kind = value::entity_type<current>;
    var immediate = 0;
    if (kind.equals(["item_display", "minecraft:item_display", "ITEM_DISPLAY"])) {
        if not (candidate.equals([previousId])) immediate = 1;
    }
    if (immediate.equals([0])) {
        select::reset();
        code::wait(2, "TICKS");
        select::entity_by_name(displayName);
    }
    if (entity::exists<current>()) {
        shNewVisual = value::uuid<current>;
        if (role.equals(["body"])) shBody = value::uuid<current>;
        entity::set_item_display_item<current>(frameItem);
        entity::set_item_display_model_type<current>("NONE");
        entity::set_display_scale<current>(scale, "SET");
        if (role.equals(["body"])) entity::set_display_culling_suze<current>(7, 7);
        if (role.equals(["mark"])) entity::set_display_brightness<current>(15, 15);
        if (role.equals(["feather"])) entity::set_display_interpolation<current>(2, 0);
    }
    select::reset();
}

function shMakeBody(start) {
    var model;
    variable::set_item_custom_model_data(model, item("paper"), 288000);
    var center = variable::shift_coordinate(start, 2.5, "Y");
    shSpawnVisual(center, henBodyName, model, vector(5, 5, 5), "body");
}

function shPoseAt(pose, aim) {
    if (shStop.equals([1])) code::return_function();
    select::entity_by_name(shBoss);
    if not (entity::exists<current>()) {
        select::reset();
        shStop = 1;
        code::return_function();
    }
    var feet = value::location<current>;
    var hp = value::health<current>;
    select::reset();

    if (shRage.equals([0])) {
        if (hp.less(80)) {
            shRage = 1;
            player::action_bar(["ЯРОСТЬ — глаза краснеют, атаки ускоряются!"]);
            player::play_sound(sound("entity.ravager.roar", 0.9, 1.4), feet);
        }
    }
    if (shBody.equals([""])) code::return_function();
    var forward = variable::face_location(feet, aim);
    forward = variable::set_coordinate(forward, 0, "PITCH");
    var center = variable::shift_coordinate(forward, 2.5, "Y");
    var modelId = 288000 + 20 * shRage + pose;
    select::entity_by_name(shBody);
    if (entity::exists<current>()) {
        entity::teleport<current>(center, "FALSE");
        if not (shFrame.equals([modelId])) {
            var frameItem;
            variable::set_item_custom_model_data(frameItem, item("paper"), modelId);
            entity::set_item_display_item<current>(frameItem);
            shFrame = modelId;
        }
    } else {
        shBody = "";
        select::entity_by_name(shBoss);
        entity::set_invisible<current>("FALSE");
    }
    select::reset();
}

function shPose(pose) {
    shPoseAt(pose, value::location);
}

function shStopMovement() {
    select::entity_by_name(shBoss);
    if (entity::exists<current>()) entity::move_to_location_stop<current>();
    select::reset();
}

function shRecovery() {
    var cycles = 8;
    if (shRage.equals([1])) cycles = 4;
    repeat::on_range(1, cycles, 1) { beat ->
        if (shStop.equals([1])) code::stop_repeat();
        shPose(0);
        code::wait(3, "TICKS");
        shPose(2);
        code::wait(3, "TICKS");
    }
    if (shStop.equals([1])) code::return_function();

    var pace = value::location;
    select::entity_by_name(shBoss);
    entity::move_to_location<current>(pace, 0.95);
    select::reset();
    repeat::on_range(1, 4, 1) { step ->
        if (shStop.equals([1])) code::stop_repeat();
        shPose(4);
        code::wait(3, "TICKS");
        shPose(6);
        code::wait(3, "TICKS");
    }
    shStopMovement();
}

function shDash() {
    player::action_bar(["Курица готовится к рывку — уйди в сторону!"]);
    player::play_sound(sound("entity.chicken.ambient", 1.6, 0.55), value::location);
    var aim = value::location;
    var charge = 6;
    if (shRage.equals([1])) charge = 3;
    repeat::on_range(1, charge, 1) { beat ->
        if (shStop.equals([1])) code::stop_repeat();
        shPoseAt(8, aim);
        code::wait(3, "TICKS");
    }
    if (shStop.equals([1])) code::return_function();

    var speed = 2.6;
    var damage = 9;
    if (shRage.equals([1])) {
        speed = 3.5;
        damage = 12;
    }
    select::entity_by_name(shBoss);
    entity::move_to_location<current>(aim, speed);
    select::reset();

    var hit = 0;
    repeat::on_range(1, 10, 1) { step ->
        if (shStop.equals([1])) code::stop_repeat();
        shPoseAt(10, aim);
        if (hit.equals([0])) {
            select::entity_by_name(shBoss);
            var origin = value::location<current>;
            select::reset();
            var distance = variable::locations_distance(value::location, origin, "THREE_D");
            if (distance.less_or_equals(2.4)) {
                if (player::gamemode_equals("SURVIVAL")) {
                    player::damage(damage);
                    hit = 1;
                }
            }
        }
        code::wait(2, "TICKS");
    }
    shStopMovement();
}

function shRemove(uuid) {
    if not (uuid.equals([""])) {
        select::entity_by_name(uuid);
        if (entity::exists<current>()) entity::remove<current>();
        select::reset();
    }
}

function shClearFeather() {
    shRemove(shFeather);
    shRemove(shMark);
    shFeather = "";
    shMark = "";
}

function shDropFeather(mark) {
    var marker;
    var feather;
    variable::set_item_custom_model_data(marker, item("paper"), 288042);
    variable::set_item_custom_model_data(feather, item("paper"), 288040);
    var floor = variable::shift_all_coordinates(mark, 0, 0.05, 0, 0, 0);
    floor = variable::set_coordinate(floor, 0, "PITCH");
    shSpawnVisual(floor, henMarkName, marker, vector(5, 1, 5), "mark");
    shMark = shNewVisual;
    player::display_particle([particle("cloud", count = 18, spread_x = 1.2, spread_y = 0.1)], [floor]);
    var warning = 10;
    var steps = 8;
    var damage = 7;
    if (shRage.equals([1])) {
        warning = 6;
        steps = 6;
        damage = 10;
    }
    shPose(12);
    code::wait(warning, "TICKS");
    if (shStop.equals([1])) {
        shClearFeather();
        code::return_function();
    }
    var high = variable::shift_coordinate(floor, 7.6, "Y");
    shSpawnVisual(high, henFeatherName, feather, vector(1.35, 1.35, 1.35), "feather");
    shFeather = shNewVisual;

    repeat::on_range(1, steps, 1) { frame ->
        if (shStop.equals([1])) code::stop_repeat();
        shPose(14);
        var progress = frame / steps;
        var elevation = 7.6 - 7.3 * progress * progress;
        var drift = (1 - progress) * 0.8;
        var fallen = variable::shift_all_coordinates(floor, drift, elevation, 0, 0, 0);
        var spin = 38 * frame;
        if not (shFeather.equals([""])) {
            select::entity_by_name(shFeather);
            entity::teleport<current>(fallen, "FALSE");
            entity::set_display_rotation_from_euler_angles<current>(12, spin, 26, "SET", "LEFT_ROTATION");
            select::reset();
        }
        code::wait(2, "TICKS");
    }

    shClearFeather();
    if (shStop.equals([1])) code::return_function();
    player::play_sound(sound("entity.firework_rocket.blast", 0.9, 0.65), floor);
    player::display_particle([particle("cloud", count = 42, spread_x = 1.4, spread_y = 0.35)], [floor]);
    var separation = variable::locations_distance(value::location, mark, "THREE_D");
    if (separation.less_or_equals(2.4)) {
        if (player::gamemode_equals("SURVIVAL")) player::damage(damage);
    }
    shPose(12);
    code::wait(3, "TICKS");
}

function shFeatherWave() {
    player::action_bar(["Дождь из перьев — выходи из отмеченных кругов!"]);
    var count = 3;
    if (shRage.equals([1])) count = 5;
    repeat::on_range(1, count, 1) { shot ->
        if (shStop.equals([1])) code::stop_repeat();
        shDropFeather(value::location);
    }
}

function shFight() {
    repeat::on_range(1, 16, 1) { round ->
        if (shStop.equals([1])) code::stop_repeat();
        shRecovery();
        if (shStop.equals([1])) code::stop_repeat();
        shDash();
        if (shStop.equals([1])) code::stop_repeat();
        shFeatherWave();
    }
    if (shDefeated.equals([1])) {
        player::message("Грозовая Курица повержена!");
    }
}

function shCleanup() {
    shClearFeather();
    shRemove(shBody);
    shRemove(shBoss);
    shBoss = "";
    shBody = "";
    shOwner = "";
    shRunning = 0;
}
function shSummon() {
    shRunning = 1;
    shStop = 0;
    shDefeated = 0;
    shRage = 0;
    shFrame = -1;
    shOwner = value::uuid;

    var start = variable::shift_coordinate(value::location, 5, "X");
    world::spawn_mob(item("ravager_spawn_egg"), start, 160, henName, natural_equipment = "FALSE");
    if (entity::name_equals<last_entity>([henName])) {
        shBoss = value::uuid<last_entity>;
        entity::set_despawning<last_entity>("FALSE");
        entity::set_max_health<last_entity>(160, "TRUE");
        entity::set_current_health<last_entity>(160);
        shMakeBody(start);
        if (shBody.equals([""])) {
            player::message("Модель не найдена. Бой продолжится с видимым разорителем.");
            shFight();
        } else {
            select::entity_by_name(shBoss);
            entity::set_invisible<current>("TRUE");
            select::reset();
            player::message("Грозовая Курица пробудилась! Бей её у ног.");
            shFight();
        }
    } else {
        player::message("Не удалось призвать курицу. Попробуй на открытой площадке.");
    }
    shCleanup();
}

event<player_chat> {
    if (player::has_privilege("OWNER", "TRUE")) {
        var message = value::event_chat_message;
        if (message.equals(["@курица стоп"])) {
            world::cancel_event();
            shStop = 1;
        }
        if (message.equals(["@курица"])) {
            world::cancel_event();
            if (shRunning.equals([1])) {
                player::message("Бой уже идёт. Для остановки напиши @курица стоп.");
            } else {
                shSummon();
            }
        }
    }
}

event<entity_damage_player> {
    if not (shBoss.equals([""])) {
        if (shBoss.equals([value::uuid<damager_entity>])) {
            world::cancel_event();
        }
    }
}

event<entity_death> {
    if not (shBoss.equals([""])) {
        if (shBoss.equals([value::uuid<default_entity>])) {
            shDefeated = 1;
            shStop = 1;
        }
    }
}

event<player_quit> {
    if (shOwner.equals([value::uuid])) shStop = 1;
}

event<player_death> {
    if (shOwner.equals([value::uuid])) shStop = 1;
}

